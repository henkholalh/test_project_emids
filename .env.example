# Copy to .env and fill in. Never commit .env.

# Location of the supplied pack (kb/, eval/, mock_services/). Relative paths resolve from the repo root.
PACK_DIR=../T4_Lead_AI_Architect_A
MOCK_BASE_URL=http://127.0.0.1:8090

# Model provider: anthropic | fake  (fake = deterministic offline adapter for tests)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=

# Per-tenant API tokens as JSON, and the third-party directory key.
TENANT_TOKENS={"plan_a": "<token>", "plan_b": "<token>"}
DIRECTORY_API_KEY=<key>

# Per-conversation budgets
BUDGET_MAX_STEPS=8
BUDGET_MAX_COST_USD=0.03
BUDGET_MAX_LATENCY_S=10
